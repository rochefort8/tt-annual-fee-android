<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7">

  <LinearLayout
      android:id="@+id/bottom_action_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentBottom="true"
      android:background="@color/white"
      android:orientation="vertical"
      android:padding="16dp">

    <Button
        android:id="@+id/checkout_button"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:enabled="false"
        android:text="@string/start_payment"
        android:textAllCaps="false"
        android:textStyle="bold" />
  </LinearLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_above="@id/bottom_action_container"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/annual_fee_payment"
            android:gravity="center"
            android:textColor="#1C1C1C"
            android:textSize="22sp"
            android:textStyle="bold" />
      </LinearLayout>

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="@string/graduation_term"
          android:textColor="#2B2B2B"
          android:textSize="14sp"
          android:textStyle="bold" />

      <Spinner
          android:id="@+id/graduation_term_spinner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:background="@drawable/amount_button_unselected"
          android:padding="10dp" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="@string/full_name"
          android:textColor="#2B2B2B"
          android:textSize="14sp"
          android:textStyle="bold" />

      <EditText
          android:id="@+id/payer_name_input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:background="@drawable/amount_button_unselected"
          android:hint="@string/name_hint"
          android:inputType="textPersonName"
          android:maxLines="1"
          android:padding="12dp" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="@string/amount"
          android:textColor="#2B2B2B"
          android:textSize="14sp"
          android:textStyle="bold" />

      <Button
          android:id="@+id/amount_social"
          style="@style/Button.Primary"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="8dp"
          android:background="@drawable/amount_button_selected"
          android:text="@string/amount_social"
          android:textAllCaps="false"
          android:textStyle="bold" />

      <Button
          android:id="@+id/amount_student"
          style="@style/Button.Primary"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/amount_button_unselected"
          android:text="@string/amount_student"
          android:textAllCaps="false"
          android:textColor="@color/owen_yellow"
          android:textStyle="bold" />

      <Button
          android:id="@+id/amount_development"
          style="@style/Button.Primary"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/amount_button_unselected"
          android:text="@string/amount_development"
          android:textAllCaps="false"
          android:textColor="@color/owen_yellow"
          android:textStyle="bold" />

    </LinearLayout>
  </ScrollView>

</RelativeLayout>
